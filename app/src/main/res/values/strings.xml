    <string name="disclosure_dialog_title">Accessibility Service Disclosure</string>
    <string name="disclosure_dialog_text">Baby Touch Lock uses Android\'s AccessibilityService API solely to block accidental screen taps, navigation gestures, and hardware buttons during media viewing.\n\n🔒 100% Local &amp; Private: No screen content, keystrokes, or personal data is ever accessed, stored, or transmitted over the internet.</string>
