<?xml version="1.0" encoding="utf-8"?>
<com.babytouchlock.BabyTouchLockUnlockView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/btn_floating_unlock"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_floating_button"
        android:gravity="center"
        android:text="@string/lock_icon_locked"
        android:textSize="26sp"
        android:alpha="0.5" />

    <LinearLayout
        android:id="@+id/pin_container"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_slider_track"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/pin_display"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="@string/pin_enter_prompt"
            android:textColor="@color/white"
            android:textSize="18sp" />
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">
            <TextView android:id="@+id/pin_1" style="@style/PinKey" android:text="1" />
            <TextView android:id="@+id/pin_2" style="@style/PinKey" android:text="2" />
            <TextView android:id="@+id/pin_3" style="@style/PinKey" android:text="3" />
            <TextView android:id="@+id/pin_4" style="@style/PinKey" android:text="4" />
            <TextView android:id="@+id/pin_5" style="@style/PinKey" android:text="5" />
            <TextView android:id="@+id/pin_6" style="@style/PinKey" android:text="6" />
            <TextView android:id="@+id/pin_7" style="@style/PinKey" android:text="7" />
            <TextView android:id="@+id/pin_8" style="@style/PinKey" android:text="8" />
            <TextView android:id="@+id/pin_9" style="@style/PinKey" android:text="9" />
            <TextView android:id="@+id/pin_clear" style="@style/PinKey" android:text="C" />
            <TextView android:id="@+id/pin_0" style="@style/PinKey" android:text="0" />
            <TextView android:id="@+id/pin_submit" style="@style/PinKey" android:text="✓" />
        </GridLayout>
        <TextView
            android:id="@+id/pin_backspace"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="@string/pin_backspace"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</com.babytouchlock.BabyTouchLockUnlockView>
